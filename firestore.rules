rules_version = '2';

// Reglas del proyecto de Firebase de la PLATAFORMA ClubStudioHQ (torneos).
// Firebase console > Firestore > Reglas: pegar este archivo completo.
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================= */
    function signedIn() {
      return request.auth != null;
    }

    // cuenta de Google (no la sesión anónima del planillero)
    function isGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isPlatformAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function organizerOf(data) {
      return isGoogle() && (
        request.auth.uid in data.organizerUids
        || (request.auth.token.email != null && request.auth.token.email.lower() in data.get("organizerEmails", []))
      );
    }

    function isOrganizer(eventId) {
      return organizerOf(eventData(eventId));
    }

    // inscripciones abiertas y sin pasar la fecha límite (registrationDeadlineAt = fin de ese día)
    function registrationOpenNow(eventId) {
      let e = eventData(eventId);
      return e.get("registrationOpen", false) == true
        && (e.get("registrationDeadlineAt", null) == null || request.time <= e.registrationDeadlineAt);
    }

    // roster cerrado (rosterDeadlineAt = fin de ese día): los equipos ya no cambian jugadores
    function rosterLockedNow(eventId) {
      let e = eventData(eventId);
      return e.get("rosterDeadlineAt", null) != null && request.time > e.rosterDeadlineAt;
    }

    // tamaño del roster según las reglas del torneo (rosterMax 0 = sin máximo)
    function rosterSizeOk(eventId, players) {
      let r = eventData(eventId).get("rules", {});
      return players.size() >= r.get("rosterMin", 0)
        && (r.get("rosterMax", 0) == 0 || players.size() <= r.get("rosterMax", 0));
    }

    function isActive(eventId) {
      return eventData(eventId).approval.status == "approved";
    }

    // visible al público: publicado o activo (para que el planillero y el público vean los partidos)
    function canRead(eventId) {
      let e = eventData(eventId);
      return e.isPublic == true || e.approval.status == "approved" || organizerOf(e) || isPlatformAdmin();
    }

    function isSquadAdmin(squadId) {
      return isGoogle()
        && request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.ownerUids;
    }

    // admin del equipo de una inscripción o de un equipo del torneo (quien la creó o los co-admins del equipo)
    function managesEntry(data) {
      return isGoogle() && (
        data.get("managerUid", "") == request.auth.uid
        || (data.get("squadId", "") != "" && isSquadAdmin(data.squadId))
      );
    }

    // admin del equipo del torneo o su capitán(a) de espíritu
    function ratesSpiritFor(eventId, teamId) {
      let t = get(/databases/$(database)/documents/events/$(eventId)/teams/$(teamId)).data;
      return managesEntry(t) || (isGoogle() && t.get("spiritCaptainId", "") == request.auth.uid);
    }

    function inviteFor(token, squadId) {
      let inv = get(/databases/$(database)/documents/squad_invites/$(token));
      return inv != null && inv.data.squadId == squadId;
    }

    function isScorekeeper(gameId) {
      return signedIn()
        && exists(/databases/$(database)/documents/game_claims/$(gameId + "_" + request.auth.uid));
    }

    /* =========================
       ADMINS DE LA PLATAFORMA (se crean a mano en la consola)
    ========================= */
    // opciones de la plataforma (ej: platform_config/divisions); las edita un admin
    match /platform_config/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    match /platform_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    /* =========================
       TORNEOS
    ========================= */
    match /events/{eventId} {
      allow read: if resource.data.isPublic == true
        || resource.data.approval.status == "approved"
        || organizerOf(resource.data)
        || isPlatformAdmin();

      // cualquiera con Google crea un torneo: queda como borrador privado y sin activar
      allow create: if isGoogle()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.organizerUids == [request.auth.uid]
        && request.resource.data.isPublic == false
        && request.resource.data.approval.status == "none";

      // organizadores: no cambian dueño ni activación (solo pueden pedirla);
      // solo se publica si está activo
      allow update: if isPlatformAdmin() || (
        organizerOf(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.organizerUids == resource.data.organizerUids
        && (
          request.resource.data.approval == resource.data.approval
          || (
            resource.data.approval.status in ["none", "rejected"]
            && request.resource.data.approval.status == "requested"
            && request.resource.data.approval.keys().hasOnly(["status", "note", "requestedAt"])
          )
        )
        && (request.resource.data.isPublic == false || resource.data.approval.status == "approved")
        // solo el dueño cambia la lista de co-organizadores
        && (request.resource.data.get("organizerEmails", []) == resource.data.get("organizerEmails", [])
            || request.auth.uid == resource.data.ownerUid)
      );

      allow delete: if isPlatformAdmin() || (isGoogle() && resource.data.ownerUid == request.auth.uid);

      match /teams/{teamId} {
        allow read: if canRead(eventId);
        allow write: if isPlatformAdmin() || isOrganizer(eventId);
        // el admin del equipo (inscripción aprobada) actualiza roster, logo y capitanes
        allow update: if managesEntry(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "city", "logo", "players", "captainId", "spiritCaptainId", "updatedAt"
          ])
          && (!rosterLockedNow(eventId) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["players"]));
      }

      // inscripciones: las manda cualquier cuenta de Google si el torneo está activo y con inscripciones abiertas
      match /registrations/{regId} {
        allow read: if isPlatformAdmin() || isOrganizer(eventId) || managesEntry(resource.data);

        allow create: if isGoogle()
          && request.resource.data.managerUid == request.auth.uid
          && (request.resource.data.get("squadId", "") == "" || isSquadAdmin(request.resource.data.squadId))
          && request.resource.data.status == "pending"
          && !("teamId" in request.resource.data)
          && isActive(eventId)
          && registrationOpenNow(eventId)
          && rosterSizeOk(eventId, request.resource.data.get("players", []));

        allow update: if isPlatformAdmin() || isOrganizer(eventId) || (
          managesEntry(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "city", "color", "logo", "divisionId", "players", "captainId", "spiritCaptainId",
            "contact", "eventName", "squadId", "status", "updatedAt"
          ])
          // el estado solo cambia de rechazada a pendiente (volver a enviar)
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == "rejected" && request.resource.data.status == "pending"
                && registrationOpenNow(eventId))
          )
          // aprobada: nombre, color y división los cambia el organizador
          && (resource.data.status != "approved"
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["name", "color", "divisionId", "squadId"]))
          // si cambia de equipo, tiene que ser uno que administra
          && (request.resource.data.get("squadId", "") == "" || isSquadAdmin(request.resource.data.squadId))
          // con el roster cerrado no se cambian jugadores; si cambian, tiene que cumplir el mínimo y máximo
          && (!rosterLockedNow(eventId) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["players"]))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["players"])
              || rosterSizeOk(eventId, request.resource.data.get("players", [])))
        );

        allow delete: if isPlatformAdmin() || isOrganizer(eventId)
          || (managesEntry(resource.data) && resource.data.status != "approved");
      }

      match /games/{gameId} {
        allow read: if canRead(eventId);
        allow create, delete: if isPlatformAdmin() || isOrganizer(eventId);
        // el planillero (link) solo toca marcador, reloj, resumen y espíritu, y solo con el torneo activo
        allow update: if isPlatformAdmin() || isOrganizer(eventId) || (
          isScorekeeper(gameId)
          && isActive(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "scoreA", "scoreB", "clock", "offenseFirst", "teamStats", "playerStats",
            "halftimeDone", "spirit", "startedAt", "finishedAt", "updatedAt", "ratioFirst"
          ])
          // ajustar el reloj es solo del organizador
          && request.resource.data.get("clock", {}).get("offsetMs", 0) == resource.data.get("clock", {}).get("offsetMs", 0)
        ) || (
          // al terminar, cada equipo (admin o capitán de espíritu) evalúa al rival: solo su lado (A o B)
          isGoogle()
          && resource.data.status == "final"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["spirit", "updatedAt"])
          && (
            (ratesSpiritFor(eventId, resource.data.teamA.id)
              && request.resource.data.spirit.diff(resource.data.get("spirit", {})).affectedKeys().hasOnly(["A"]))
            || (ratesSpiritFor(eventId, resource.data.teamB.id)
              && request.resource.data.spirit.diff(resource.data.get("spirit", {})).affectedKeys().hasOnly(["B"]))
          )
        );

        match /plays/{playId} {
          allow read: if canRead(eventId);
          allow write: if isPlatformAdmin() || isOrganizer(eventId);
          // planillero: crea jugadas a su nombre (sin ajustes de reloj) y solo puede anularlas,
          // nunca borrarlas ni editarlas, para que el historial quede completo
          allow create: if isScorekeeper(gameId) && isActive(eventId)
            && request.resource.data.by == request.auth.uid
            && request.resource.data.type != "clock_adjust";
          allow update: if isScorekeeper(gameId) && isActive(eventId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deleted", "deletedAt", "deletedBy", "deletedByRole", "updatedAt"])
            && request.resource.data.deleted == true
            && request.resource.data.deletedBy == request.auth.uid;
        }
      }
    }

    /* =========================
       EQUIPOS PERMANENTES (como un club)
    ========================= */
    match /squads/{squadId} {
      // página pública del equipo
      allow read: if true;

      allow create: if isGoogle()
        && request.resource.data.ownerUids == [request.auth.uid];

      allow update: if isGoogle() && (
        // admins: todo, mientras quede al menos un admin
        (request.auth.uid in resource.data.ownerUids && request.resource.data.ownerUids.size() > 0)
        // co-admin nuevo con el link de admin: solo se agrega a sí mismo
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerUids", "joinToken", "updatedAt"])
          && request.resource.data.ownerUids.hasAll(resource.data.ownerUids)
          && request.resource.data.ownerUids.size() == resource.data.ownerUids.size() + 1
          && request.auth.uid in request.resource.data.ownerUids
          && inviteFor(request.resource.data.joinToken, squadId)
          && get(/databases/$(database)/documents/squad_invites/$(request.resource.data.joinToken)).data.role == "admin"
        )
      );

      allow delete: if isGoogle() && request.auth.uid in resource.data.ownerUids;

      // roster: id = uid del jugador con cuenta, o id al azar si lo cargó un admin
      match /members/{memberId} {
        allow read: if true;
        allow write: if isSquadAdmin(squadId);
        // jugador: se une con el link, edita sus datos y puede salir
        allow create: if isGoogle()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && inviteFor(request.resource.data.joinToken, squadId);
        allow update: if isGoogle()
          && memberId == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "number", "gender", "photoURL", "updatedAt"]);
        allow delete: if isGoogle() && memberId == request.auth.uid;
      }

      // tokens vigentes de invitación
      match /private/{docId} {
        allow read, write: if isSquadAdmin(squadId);
      }

      // torneos donde se inscribió (público, para historial)
      match /tournaments/{eventId} {
        allow read: if true;
        allow write: if isSquadAdmin(squadId);
      }
    }

    // link de invitación: quien tiene el token lo puede leer (no se pueden listar)
    match /squad_invites/{token} {
      allow get: if true;
      allow create: if isGoogle()
        && request.resource.data.createdBy == request.auth.uid
        && isSquadAdmin(request.resource.data.squadId);
      allow delete: if isGoogle() && isSquadAdmin(resource.data.squadId);
    }

    // perfil público del jugador; solo él lo edita
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isGoogle() && request.auth.uid == uid;
    }

    /* =========================
       LINKS DE PLANILLERO
    ========================= */
    match /game_keys/{token} {
      allow read: if isPlatformAdmin() || isOrganizer(resource.data.eventId);
      // solo con el torneo activo
      allow create: if isPlatformAdmin() || (isOrganizer(request.resource.data.eventId) && isActive(request.resource.data.eventId));
      allow update, delete: if isPlatformAdmin() || isOrganizer(resource.data.eventId);
    }

    match /game_claims/{claimId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && claimId == request.resource.data.gameId + "_" + request.auth.uid
        && exists(/databases/$(database)/documents/game_keys/$(request.resource.data.token))
        && get(/databases/$(database)/documents/game_keys/$(request.resource.data.token)).data.gameId == request.resource.data.gameId;
      allow update, delete: if isPlatformAdmin();
    }
  }
}
