rules_version = '2';

// Reglas del proyecto de Firebase de la PLATAFORMA ClubStudioHQ (torneos).
// Firebase console > Firestore > Reglas: pegar este archivo completo.
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================= */
    function signedIn() {
      return request.auth != null;
    }

    // cuenta de Google (no la sesión anónima del planillero)
    function isGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isPlatformAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function organizerOf(data) {
      return isGoogle() && (
        request.auth.uid in data.organizerUids
        || (request.auth.token.email != null && request.auth.token.email.lower() in data.get("organizerEmails", []))
      );
    }

    function isOrganizer(eventId) {
      return organizerOf(eventData(eventId));
    }

    // inscripciones abiertas y sin pasar la fecha límite (registrationDeadlineAt = fin de ese día)
    function registrationOpenNow(eventId) {
      let e = eventData(eventId);
      return e.get("registrationOpen", false) == true
        && (e.get("registrationDeadlineAt", null) == null || request.time <= e.registrationDeadlineAt);
    }

    // roster cerrado (rosterDeadlineAt = fin de ese día): los equipos ya no cambian jugadores
    function rosterLockedNow(eventId) {
      let e = eventData(eventId);
      return e.get("rosterDeadlineAt", null) != null && request.time > e.rosterDeadlineAt;
    }

    // tamaño del roster según las reglas del torneo (rosterMax 0 = sin máximo)
    function rosterSizeOk(eventId, players) {
      let r = eventData(eventId).get("rules", {});
      return players.size() >= r.get("rosterMin", 0)
        && (r.get("rosterMax", 0) == 0 || players.size() <= r.get("rosterMax", 0));
    }

    function isActive(eventId) {
      return eventData(eventId).approval.status == "approved";
    }

    // visible al público: publicado o activo (para que el planillero y el público vean los partidos)
    function canRead(eventId) {
      let e = eventData(eventId);
      return e.isPublic == true || e.approval.status == "approved" || organizerOf(e) || isPlatformAdmin();
    }

    function isSquadAdmin(squadId) {
      return isGoogle()
        && request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.ownerUids;
    }

    // admin del equipo de una inscripción o de un equipo del torneo (quien la creó o los co-admins del equipo)
    function managesEntry(data) {
      return isGoogle() && (
        data.get("managerUid", "") == request.auth.uid
        || (data.get("squadId", "") != "" && isSquadAdmin(data.squadId))
      );
    }

    // admin del equipo del torneo o su capitán(a) de espíritu
    function ratesSpiritFor(eventId, teamId) {
      let t = get(/databases/$(database)/documents/events/$(eventId)/teams/$(teamId)).data;
      return managesEntry(t) || (isGoogle() && t.get("spiritCaptainId", "") == request.auth.uid);
    }

    function inviteFor(token, squadId) {
      let inv = get(/databases/$(database)/documents/squad_invites/$(token));
      return inv != null && inv.data.squadId == squadId;
    }

    // torneo hat: cada jugador se inscribe solo y el organizador arma los equipos
    function isHat(eventId) {
      return eventData(eventId).get("type", "") == "hat";
    }

    function isScorekeeper(gameId) {
      return signedIn()
        && exists(/databases/$(database)/documents/game_claims/$(gameId + "_" + request.auth.uid));
    }

    /* =========================
       ADMINS DE LA PLATAFORMA (se crean a mano en la consola)
    ========================= */
    // opciones de la plataforma (ej: platform_config/divisions); las edita un admin
    match /platform_config/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    match /platform_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    /* =========================
       TORNEOS
    ========================= */
    match /events/{eventId} {
      allow read: if resource.data.isPublic == true
        || resource.data.approval.status == "approved"
        || organizerOf(resource.data)
        || isPlatformAdmin();

      // cualquiera con Google crea un torneo: queda como borrador privado y sin activar
      allow create: if isGoogle()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.organizerUids == [request.auth.uid]
        && request.resource.data.isPublic == false
        && request.resource.data.approval.status == "none";

      // organizadores: no cambian dueño ni activación (solo pueden pedirla);
      // solo se publica si está activo
      allow update: if isPlatformAdmin() || (
        organizerOf(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.organizerUids == resource.data.organizerUids
        && (
          request.resource.data.approval == resource.data.approval
          || (
            resource.data.approval.status in ["none", "rejected"]
            && request.resource.data.approval.status == "requested"
            && request.resource.data.approval.keys().hasOnly(["status", "note", "requestedAt"])
          )
        )
        && (request.resource.data.isPublic == false || resource.data.approval.status == "approved")
        // solo el dueño cambia la lista de co-organizadores
        && (request.resource.data.get("organizerEmails", []) == resource.data.get("organizerEmails", [])
            || request.auth.uid == resource.data.ownerUid)
      );

      allow delete: if isPlatformAdmin() || (isGoogle() && resource.data.ownerUid == request.auth.uid);

      match /teams/{teamId} {
        allow read: if canRead(eventId);
        allow write: if isPlatformAdmin() || isOrganizer(eventId);
        // el admin del equipo (inscripción aprobada) actualiza roster, logo y capitanes
        allow update: if managesEntry(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "city", "logo", "players", "captainId", "spiritCaptainId", "updatedAt"
          ])
          && (!rosterLockedNow(eventId) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["players"]));
      }

      // inscripciones: las manda cualquier cuenta de Google si el torneo está activo y con inscripciones abiertas
      // formulario de exención: los datos (emergencia, salud) solo los ven el jugador y el organizador
      match /waivers/{uid} {
        allow read: if isPlatformAdmin() || isOrganizer(eventId) || (signedIn() && request.auth.uid == uid);
        allow create, update: if isGoogle() && request.auth.uid == uid && request.resource.data.uid == uid;
        allow delete: if isPlatformAdmin() || isOrganizer(eventId);
      }
      // quién firmó (sin datos privados): lo ven el equipo y el organizador
      match /waiver_status/{uid} {
        allow read: if canRead(eventId);
        allow create, update: if isGoogle() && request.auth.uid == uid && request.resource.data.uid == uid;
        allow delete: if isPlatformAdmin() || isOrganizer(eventId);
      }

      /* ----- Hat ----- */
      // pool de jugadores (uno por división): lo ve quien ve el torneo, sin puntajes ni datos privados.
      // id = {uid}__{divisionId}. El jugador lo crea y edita mientras las inscripciones están abiertas
      // y todavía no tiene equipo; el estado (en espera / lista de espera / asignado) es del organizador.
      match /hat_players/{entryId} {
        allow read: if canRead(eventId);
        allow write: if isPlatformAdmin() || isOrganizer(eventId);
        allow create: if isGoogle()
          && request.resource.data.uid == request.auth.uid
          && entryId == request.auth.uid + "__" + request.resource.data.divisionId
          && isHat(eventId)
          && isActive(eventId)
          && registrationOpenNow(eventId)
          && request.resource.data.status in ["waiting", "waitlist"]
          && request.resource.data.get("teamId", "") == ""
          && request.resource.data.get("paymentStatus", "none") in ["none", "submitted"];
        allow update: if isGoogle()
          && resource.data.uid == request.auth.uid
          && resource.data.status != "assigned"
          && registrationOpenNow(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "number", "gender", "photoURL", "jersey", "position", "teammateUid", "paymentStatus", "updatedAt"
          ])
          // el comprobante se manda (submitted); aprobarlo o rechazarlo es del organizador
          && (request.resource.data.get("paymentStatus", "none") == resource.data.get("paymentStatus", "none")
              || (request.resource.data.paymentStatus == "submitted" && resource.data.get("paymentStatus", "none") != "approved"));
        // el comprobante se puede mandar después: con inscripciones cerradas o ya con equipo
        allow update: if isGoogle()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus", "updatedAt"])
          && request.resource.data.paymentStatus == "submitted"
          && resource.data.get("paymentStatus", "none") != "approved";
        allow delete: if isGoogle()
          && resource.data.uid == request.auth.uid
          && resource.data.status != "assigned";
      }

      // autoevaluación y puntajes del hat: PRIVADO. Solo el organizador los lee; el jugador manda
      // sus respuestas (y su fecha de nacimiento) pero nunca las vuelve a leer ni toca el puntaje del organizador.
      match /hat_ratings/{uid} {
        allow read, write: if isPlatformAdmin() || isOrganizer(eventId);
        allow create: if isGoogle()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && isHat(eventId)
          && registrationOpenNow(eventId)
          && request.resource.data.keys().hasOnly(["uid", "answers", "selfScore", "birthDate", "updatedAt"]);
        allow update: if isGoogle()
          && request.auth.uid == uid
          && registrationOpenNow(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answers", "selfScore", "birthDate", "updatedAt"]);
      }

      // comprobante de pago de la cuota por jugador: lo ven el jugador y el organizador
      match /hat_payments/{entryId} {
        allow read: if isPlatformAdmin() || isOrganizer(eventId)
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow write: if isPlatformAdmin() || isOrganizer(eventId);
        allow create, update: if isGoogle()
          && request.resource.data.uid == request.auth.uid
          && entryId == request.auth.uid + "__" + request.resource.data.divisionId
          && request.resource.data.status == "submitted"
          && (resource == null || resource.data.get("status", "none") != "approved");
      }

      // borradores de equipos (armado y cambios antes de publicar): solo el organizador
      match /hat_drafts/{divisionId} {
        allow read, write: if isPlatformAdmin() || isOrganizer(eventId);
      }

      match /registrations/{regId} {
        allow read: if isPlatformAdmin() || isOrganizer(eventId) || managesEntry(resource.data);

        allow create: if isGoogle()
          && request.resource.data.managerUid == request.auth.uid
          && (request.resource.data.get("squadId", "") == "" || isSquadAdmin(request.resource.data.squadId))
          && request.resource.data.status == "pending"
          && !("teamId" in request.resource.data)
          && isActive(eventId)
          && registrationOpenNow(eventId)
          && rosterSizeOk(eventId, request.resource.data.get("players", []))
          && request.resource.data.get("paymentStatus", "none") in ["none", "submitted"];

        allow update: if isPlatformAdmin() || isOrganizer(eventId) || (
          managesEntry(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "city", "color", "logo", "divisionId", "players", "captainId", "spiritCaptainId",
            "contact", "eventName", "squadId", "status", "updatedAt"
          ])
          // el estado solo cambia de rechazada a pendiente (volver a enviar)
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == "rejected" && request.resource.data.status == "pending"
                && registrationOpenNow(eventId))
          )
          // aprobada: nombre, color y división los cambia el organizador
          && (resource.data.status != "approved"
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["name", "color", "divisionId", "squadId"]))
          // si cambia de equipo, tiene que ser uno que administra
          && (request.resource.data.get("squadId", "") == "" || isSquadAdmin(request.resource.data.squadId))
          // con el roster cerrado no se cambian jugadores; si cambian, tiene que cumplir el mínimo y máximo
          && (!rosterLockedNow(eventId) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["players"]))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["players"])
              || rosterSizeOk(eventId, request.resource.data.get("players", [])))
        ) || (
          // el equipo sube (o cambia) el comprobante de pago; aprobarlo es solo del organizador
          managesEntry(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentProof", "paymentStatus", "paymentAt", "updatedAt"])
          && request.resource.data.paymentStatus == "submitted"
          && resource.data.get("paymentStatus", "none") != "approved"
        );

        allow delete: if isPlatformAdmin() || isOrganizer(eventId)
          || (managesEntry(resource.data) && resource.data.status != "approved");
      }

      match /games/{gameId} {
        allow read: if canRead(eventId);
        allow create, delete: if isPlatformAdmin() || isOrganizer(eventId);
        // el planillero (link) solo toca marcador, reloj, resumen y espíritu, y solo con el torneo activo
        allow update: if isPlatformAdmin() || isOrganizer(eventId) || (
          isScorekeeper(gameId)
          && isActive(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "scoreA", "scoreB", "clock", "offenseFirst", "teamStats", "playerStats",
            "halftimeDone", "spirit", "startedAt", "finishedAt", "updatedAt", "ratioFirst"
          ])
          // ajustar el reloj es solo del organizador
          && request.resource.data.get("clock", {}).get("offsetMs", 0) == resource.data.get("clock", {}).get("offsetMs", 0)
        ) || (
          // al terminar, cada equipo (admin o capitán de espíritu) evalúa al rival: solo su lado (A o B)
          isGoogle()
          && resource.data.status == "final"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["spirit", "updatedAt"])
          && (
            (ratesSpiritFor(eventId, resource.data.teamA.id)
              && request.resource.data.spirit.diff(resource.data.get("spirit", {})).affectedKeys().hasOnly(["A"]))
            || (ratesSpiritFor(eventId, resource.data.teamB.id)
              && request.resource.data.spirit.diff(resource.data.get("spirit", {})).affectedKeys().hasOnly(["B"]))
          )
        );

        match /plays/{playId} {
          allow read: if canRead(eventId);
          allow write: if isPlatformAdmin() || isOrganizer(eventId);
          // planillero: crea jugadas a su nombre (sin ajustes de reloj) y solo puede anularlas,
          // nunca borrarlas ni editarlas, para que el historial quede completo
          allow create: if isScorekeeper(gameId) && isActive(eventId)
            && request.resource.data.by == request.auth.uid
            && request.resource.data.type != "clock_adjust";
          allow update: if isScorekeeper(gameId) && isActive(eventId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deleted", "deletedAt", "deletedBy", "deletedByRole", "updatedAt"])
            && request.resource.data.deleted == true
            && request.resource.data.deletedBy == request.auth.uid;
        }
      }
    }

    /* =========================
       EQUIPOS PERMANENTES (como un club)
    ========================= */
    match /squads/{squadId} {
      // página pública del equipo
      allow read: if true;

      allow create: if isGoogle()
        && request.resource.data.ownerUids == [request.auth.uid];

      // super usuario de la plataforma: puede ajustar cualquier club (logo, color, datos)
      allow update: if isPlatformAdmin() || isGoogle() && (
        // admins: todo, mientras quede al menos un admin
        (request.auth.uid in resource.data.ownerUids && request.resource.data.ownerUids.size() > 0)
        // co-admin nuevo con el link de admin: solo se agrega a sí mismo
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerUids", "joinToken", "updatedAt"])
          && request.resource.data.ownerUids.hasAll(resource.data.ownerUids)
          && request.resource.data.ownerUids.size() == resource.data.ownerUids.size() + 1
          && request.auth.uid in request.resource.data.ownerUids
          && inviteFor(request.resource.data.joinToken, squadId)
          && get(/databases/$(database)/documents/squad_invites/$(request.resource.data.joinToken)).data.role == "admin"
        )
      );

      allow delete: if isGoogle() && request.auth.uid in resource.data.ownerUids;

      // roster: id = uid del jugador con cuenta, o id al azar si lo cargó un admin
      match /members/{memberId} {
        allow read: if true;
        allow write: if isSquadAdmin(squadId) || isPlatformAdmin();
        // jugador: se une con el link, edita sus datos y puede salir
        allow create: if isGoogle()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && inviteFor(request.resource.data.joinToken, squadId);
        allow update: if isGoogle()
          && memberId == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "number", "gender", "photoURL", "updatedAt"]);
        allow delete: if isGoogle() && memberId == request.auth.uid;
      }

      // avisos para los admins (ej. "X se unió al roster"): solo los admins los leen y marcan como vistos.
      // El jugador que se unió crea el suyo, ya estando en el roster.
      match /notices/{noticeId} {
        allow read, delete: if isSquadAdmin(squadId);
        allow update: if isSquadAdmin(squadId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"]);
        allow create: if isGoogle()
          && request.resource.data.type == "member_joined"
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.readBy == []
          && exists(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid));
      }

      // tokens vigentes de invitación
      match /private/{docId} {
        allow read, write: if isSquadAdmin(squadId);
      }

      // torneos donde se inscribió (público, para historial)
      match /tournaments/{eventId} {
        allow read: if true;
        // admin de la plataforma: vincula un equipo de un torneo importado con este equipo
        allow write: if isSquadAdmin(squadId) || isPlatformAdmin();
      }
    }

    // link de invitación: quien tiene el token lo puede leer (no se pueden listar)
    match /squad_invites/{token} {
      allow get: if true;
      allow create: if isGoogle()
        && request.resource.data.createdBy == request.auth.uid
        && isSquadAdmin(request.resource.data.squadId);
      allow delete: if isGoogle() && isSquadAdmin(resource.data.squadId);
    }

    // perfil público del jugador; solo él lo edita
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isGoogle() && request.auth.uid == uid;

      // datos privados del jugador (fecha de nacimiento): solo él
      match /private/{docId} {
        allow read, write: if isGoogle() && request.auth.uid == uid;
      }
    }


    // cuenta asignada a un jugador sin cuenta de un torneo (ej. importado); id = {eventId}__{playerId}.
    // Público para que el perfil muestre el torneo; solo un admin de la plataforma lo asigna o lo quita.
    match /player_claims/{claimId} {
      allow read: if true;
      allow write: if isPlatformAdmin()
        && (request.resource == null || claimId == request.resource.data.eventId + "__" + request.resource.data.playerId);
    }

    // "Soy yo": un jugador pide que le asignen una ficha sin cuenta de un torneo (ej. importado).
    // id = {eventId}__{playerId}__{uid}. Lo ve él y el admin de la plataforma, que la aprueba o la rechaza.
    /* =========================
       ORGANIZACIONES (asociación, liga, club o persona) y PICKUPS
       Una organización hace pickups solo si el admin de la plataforma le activó features.pickups.
    ========================= */
    function orgData(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)).data;
    }

    function isOrgAdmin(orgId) {
      return isGoogle() && request.auth.uid in orgData(orgId).ownerUids;
    }

    // activo y sin vencer (features.pickupsUntil null = sin fecha de vencimiento)
    function orgHasPickups(orgId) {
      let f = orgData(orgId).get("features", {});
      return f.get("pickups", false) == true
        && (f.get("pickupsUntil", null) == null || request.time < f.get("pickupsUntil", null));
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function orgInviteFor(token, orgId) {
      let inv = get(/databases/$(database)/documents/org_invites/$(token));
      return inv != null && inv.data.orgId == orgId && inv.data.role == "admin";
    }

    function pkData(pickupId) {
      return get(/databases/$(database)/documents/pickups/$(pickupId)).data;
    }

    function isPickupAdmin(pickupId) {
      return isOrgAdmin(pkData(pickupId).orgId);
    }

    match /orgs/{orgId} {
      allow read: if true;

      // el permiso de pickups (features) solo lo da el admin de la plataforma
      // el admin de la plataforma también la crea para un correo (pendingEmails) con el permiso ya puesto
      allow create: if isPlatformAdmin() || (isGoogle()
        && request.resource.data.ownerUids == [request.auth.uid]
        && !("features" in request.resource.data));

      allow update: if isPlatformAdmin() || isGoogle() && (
        (
          request.auth.uid in resource.data.ownerUids
          && request.resource.data.ownerUids.size() > 0
          && request.resource.data.get("features", {}) == resource.data.get("features", {})
        )
        // correo invitado (pendingEmails): al entrar con esa cuenta de Google se vuelve admin
        || (
          request.auth.token.email_verified == true
          && myEmail() in resource.data.get("pendingEmails", [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerUids", "pendingEmails", "updatedAt"])
          && request.resource.data.ownerUids.hasAll(resource.data.ownerUids)
          && request.resource.data.ownerUids.size() == resource.data.ownerUids.size() + 1
          && request.auth.uid in request.resource.data.ownerUids
          && !(myEmail() in request.resource.data.pendingEmails)
          && resource.data.pendingEmails.hasAll(request.resource.data.pendingEmails)
          && request.resource.data.pendingEmails.size() == resource.data.pendingEmails.size() - 1
        )
        // co-admin nuevo con el link: solo se agrega a sí mismo
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerUids", "joinToken", "updatedAt"])
          && request.resource.data.ownerUids.hasAll(resource.data.ownerUids)
          && request.resource.data.ownerUids.size() == resource.data.ownerUids.size() + 1
          && request.auth.uid in request.resource.data.ownerUids
          && orgInviteFor(request.resource.data.joinToken, orgId)
        )
      );

      allow delete: if isPlatformAdmin() || (isGoogle() && request.auth.uid in resource.data.ownerUids);

      // links de invitación vigentes (solo admins)
      match /private/{docId} {
        allow read, write: if isPlatformAdmin() || isOrgAdmin(orgId);
      }
    }

    match /org_invites/{token} {
      allow get: if true;
      allow create: if isGoogle()
        && request.resource.data.createdBy == request.auth.uid
        && isOrgAdmin(request.resource.data.orgId);
      allow delete: if isGoogle() && isOrgAdmin(resource.data.orgId);
    }

    match /pickups/{pickupId} {
      allow read: if resource.data.isPublic == true || isPlatformAdmin() || isOrgAdmin(resource.data.orgId);
      allow create: if isPlatformAdmin()
        || (isOrgAdmin(request.resource.data.orgId) && orgHasPickups(request.resource.data.orgId));
      allow update: if isPlatformAdmin()
        || (isOrgAdmin(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId && orgHasPickups(resource.data.orgId));
      allow delete: if isPlatformAdmin() || isOrgAdmin(resource.data.orgId);

      // lista pública: nombre, tarifa y estado. El comprobante va en /private
      match /players/{playerId} {
        allow read: if true;
        allow write: if isPlatformAdmin() || isPickupAdmin(pickupId);

        // anotarse (yo o un amigo que anoto yo) mientras el pickup esté publicado y no haya empezado
        allow create: if isGoogle()
          && pkData(pickupId).status == "published"
          && request.time < pkData(pickupId).startAt
          && request.resource.data.status == "active"
          && request.resource.data.paymentStatus in ["none", "free"]
          && request.resource.data.attendance == null
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && (
            (playerId == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.source == "self")
            || (request.resource.data.uid == null && request.resource.data.source == "friend")
          );

        allow update: if isGoogle()
          && (resource.data.uid == request.auth.uid || resource.data.addedBy == request.auth.uid)
          && (
            // salirse: solo antes de la hora límite (después queda en la lista y debe)
            (
              resource.data.status == "active"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "leftAt", "updatedAt"])
              && request.resource.data.status == "left"
              && request.time < pkData(pickupId).leaveDeadlineAt
            )
            // comprobante subido (o vuelto a subir si lo rechazaron)
            || (
              resource.data.status == "active"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus", "paymentAt", "updatedAt"])
              && request.resource.data.paymentStatus == "submitted"
              && resource.data.paymentStatus in ["none", "rejected"]
            )
            // volver a anotarse después de salirse: queda al final de la fila
            || (
              resource.data.status == "left"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "joinedAt", "leftAt", "tierId", "tierName", "price", "name", "number", "gender", "photoURL", "paymentStatus", "updatedAt"])
              && request.resource.data.status == "active"
              && request.resource.data.joinedAt == request.time
              && (request.resource.data.paymentStatus == resource.data.paymentStatus || request.resource.data.paymentStatus in ["none", "free"])
              && pkData(pickupId).status == "published"
              && request.time < pkData(pickupId).startAt
            )
          );

        // comprobante: el jugador (o quien lo anotó) y los admins de la organización
        match /private/{docId} {
          allow read, write: if isPlatformAdmin() || isPickupAdmin(pickupId) || (
            isGoogle() && (
              get(/databases/$(database)/documents/pickups/$(pickupId)/players/$(playerId)).data.uid == request.auth.uid
              || get(/databases/$(database)/documents/pickups/$(pickupId)/players/$(playerId)).data.addedBy == request.auth.uid
            )
          );
        }
      }
    }

    // Pedidos para migrar un torneo desde otra plataforma (formulario público en /tournaments/)
    match /migration_requests/{reqId} {
      allow read, update, delete: if isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid", "email", "name", "phone", "link", "notes", "status", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 40
        && request.resource.data.link is string && request.resource.data.link.matches("https?://.+") && request.resource.data.link.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    match /claim_requests/{reqId} {
      allow read: if isPlatformAdmin() || (isGoogle() && resource.data.uid == request.auth.uid);
      allow create: if isGoogle()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && reqId == request.resource.data.eventId + "__" + request.resource.data.playerId + "__" + request.auth.uid;
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin() || (isGoogle() && resource.data.uid == request.auth.uid);
    }

    /* =========================
       LINKS DE PLANILLERO
    ========================= */
    match /game_keys/{token} {
      allow read: if isPlatformAdmin() || isOrganizer(resource.data.eventId);
      // solo con el torneo activo
      allow create: if isPlatformAdmin() || (isOrganizer(request.resource.data.eventId) && isActive(request.resource.data.eventId));
      allow update, delete: if isPlatformAdmin() || isOrganizer(resource.data.eventId);
    }

    match /game_claims/{claimId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && claimId == request.resource.data.gameId + "_" + request.auth.uid
        && exists(/databases/$(database)/documents/game_keys/$(request.resource.data.token))
        && get(/databases/$(database)/documents/game_keys/$(request.resource.data.token)).data.gameId == request.resource.data.gameId;
      allow update, delete: if isPlatformAdmin();
    }
  }
}
